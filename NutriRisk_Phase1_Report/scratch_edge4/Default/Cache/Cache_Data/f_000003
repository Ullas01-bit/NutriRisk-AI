/* ==========================================================================
   NutriRisk AI — Clinical Design System
   Medical Technology & Health Analytics Interface
   ========================================================================== */

:root {
  --primary-teal: #0d9488;
  --primary-teal-dark: #0f766e;
  --primary-teal-light: #ccfbf1;
  --primary-teal-focus: rgba(13, 148, 136, 0.25);
  
  --emerald-accent: #10b981;
  --emerald-light: #d1fae5;
  
  --navy-dark: #0f172a;
  --navy-muted: #334155;
  --slate-text: #475569;
  --slate-subtle: #64748b;
  
  --bg-page: #f8fafc;
  --bg-surface: #ffffff;
  --bg-subtle: #f1f5f9;
  
  --border-subtle: #e2e8f0;
  --border-card: #e5e9ee;
  
  --risk-low: #15803d;
  --risk-low-bg: #dcfce7;
  --risk-low-border: #bbf7d0;
  
  --risk-moderate: #d97706;
  --risk-moderate-bg: #fef3c7;
  --risk-moderate-border: #fde68a;
  
  --risk-high: #dc2626;
  --risk-high-bg: #fee2e2;
  --risk-high-border: #fecaca;
  
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.05);
  --shadow-card: 0 4px 16px rgba(15, 23, 42, 0.04), 0 1px 3px rgba(15, 23, 42, 0.03);
  --shadow-hover: 0 10px 25px rgba(15, 23, 42, 0.08);
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-pill: 9999px;
}

/* Base Reset & Typography */
body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  background-color: var(--bg-page);
  color: var(--navy-dark);
  line-height: 1.6;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

h1, h2, h3, h4, h5, h6 {
  color: var(--navy-dark);
  font-weight: 700;
  letter-spacing: -0.02em;
}

/* --------------------------------------------------------------------------
   App Layout (Sidebar + Header + Main Workspace)
   -------------------------------------------------------------------------- */
.app-wrapper {
  display: flex;
  min-height: 100vh;
  width: 100%;
}

/* Sidebar Navigation */
.app-sidebar {
  width: 260px;
  background-color: var(--bg-surface);
  border-right: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 1040;
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.sidebar-brand {
  padding: 1.25rem 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  border-bottom: 1px solid var(--border-subtle);
  text-decoration: none;
}

.brand-icon-box {
  width: 40px;
  height: 40px;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, var(--primary-teal), var(--primary-teal-dark));
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 1.25rem;
  box-shadow: 0 2px 8px rgba(13, 148, 136, 0.25);
  flex-shrink: 0;
}

.brand-title {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--navy-dark);
  line-height: 1.2;
}

.brand-subtitle {
  font-size: 0.75rem;
  color: var(--slate-subtle);
  font-weight: 500;
}

.sidebar-nav-container {
  padding: 1rem 0.75rem;
  flex-grow: 1;
  overflow-y: auto;
}

.sidebar-category-header {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--slate-subtle);
  font-weight: 700;
  padding: 0.75rem 0.75rem 0.35rem 0.75rem;
}

.sidebar-nav-link {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding: 0.65rem 0.85rem;
  border-radius: var(--radius-md);
  color: var(--slate-text);
  font-size: 0.92rem;
  font-weight: 500;
  text-decoration: none;
  transition: all 0.2s ease;
  margin-bottom: 0.25rem;
}

.sidebar-nav-link:hover {
  background-color: var(--bg-subtle);
  color: var(--primary-teal);
}

.sidebar-nav-link.active {
  background-color: var(--primary-teal);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 4px 12px rgba(13, 148, 136, 0.25);
}

.sidebar-nav-icon {
  font-size: 1.1rem;
  width: 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.sidebar-user-footer {
  padding: 1rem;
  border-top: 1px solid var(--border-subtle);
  background-color: var(--bg-surface);
}

/* Main Content Workspace */
.app-content-workspace {
  flex-grow: 1;
  margin-left: 260px;
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  transition: margin-left 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* App Header */
.app-header {
  background-color: var(--bg-surface);
  border-bottom: 1px solid var(--border-subtle);
  padding: 0.85rem 1.75rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: sticky;
  top: 0;
  z-index: 1030;
}

.header-search {
  max-width: 380px;
  width: 100%;
}

.mobile-sidebar-toggle {
  display: none;
  background: none;
  border: none;
  font-size: 1.35rem;
  color: var(--navy-dark);
  cursor: pointer;
  padding: 0.25rem 0.5rem;
}

/* --------------------------------------------------------------------------
   Cards & Medical Containers
   -------------------------------------------------------------------------- */
.clinical-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-lg);
  padding: 1.5rem;
  box-shadow: var(--shadow-card);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  margin-bottom: 1.5rem;
}

.clinical-card.interactive:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-hover);
}

.card-header-clean {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--border-subtle);
  padding-bottom: 0.85rem;
  margin-bottom: 1.25rem;
}

/* Stat & KPI Cards */
.stat-kpi-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-lg);
  padding: 1.25rem 1.35rem;
  box-shadow: var(--shadow-card);
  display: flex;
  flex-direction: column;
  height: 100%;
  position: relative;
  overflow: hidden;
}

.stat-icon-wrapper {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0.75rem;
  flex-shrink: 0;
}

.stat-icon-wrapper.teal {
  background-color: var(--primary-teal-light);
  color: var(--primary-teal-dark);
}

.stat-icon-wrapper.emerald {
  background-color: var(--emerald-light);
  color: #047857;
}

.stat-icon-wrapper.amber {
  background-color: var(--risk-moderate-bg);
  color: var(--risk-moderate);
}

.stat-icon-wrapper.navy {
  background-color: #f1f5f9;
  color: #334155;
  border: 1px solid #e2e8f0;
}

.stat-icon-wrapper.blue {
  background-color: #e0f2fe;
  color: #0369a1;
}

.stat-icon-wrapper.red {
  background-color: var(--risk-high-bg);
  color: var(--risk-high);
}

.stat-label {
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--slate-subtle);
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.stat-value {
  font-size: 2rem;
  font-weight: 800;
  color: var(--navy-dark);
  line-height: 1.2;
  margin: 0.25rem 0;
}

.stat-trend {
  font-size: 0.82rem;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.stat-trend.positive {
  color: var(--emerald-accent);
}

.stat-trend.neutral {
  color: var(--slate-subtle);
}

/* --------------------------------------------------------------------------
   Assessment Multi-Section Form (Inspired by Image 2)
   -------------------------------------------------------------------------- */
.form-step-card {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-lg);
  padding: 1.5rem 1.75rem;
  margin-bottom: 1.25rem;
  box-shadow: var(--shadow-card);
  position: relative;
  transition: border-color 0.2s ease, box-shadow 0.2s ease;
}

.form-step-card:focus-within {
  border-color: var(--primary-teal);
  box-shadow: 0 0 0 4px var(--primary-teal-focus);
}

.step-number-badge {
  position: absolute;
  top: 1.25rem;
  right: 1.5rem;
  font-size: 1rem;
  font-weight: 800;
  color: #cbd5e1;
}

.question-title {
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--navy-dark);
  margin-bottom: 0.35rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.question-desc {
  font-size: 0.86rem;
  color: var(--slate-subtle);
  margin-bottom: 1rem;
}

/* Segmented Pill Toggle Buttons */
.segmented-pill-group {
  display: flex;
  gap: 0.65rem;
  flex-wrap: wrap;
}

.segmented-pill-option {
  position: relative;
  flex: 1 1 auto;
}

.segmented-pill-option input[type="radio"] {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
}

.segmented-pill-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.4rem;
  padding: 0.75rem 1.25rem;
  background-color: var(--bg-subtle);
  border: 2px solid transparent;
  border-radius: var(--radius-md);
  color: var(--slate-text);
  font-size: 0.95rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s ease;
  user-select: none;
  text-align: center;
}

.segmented-pill-btn:hover {
  background-color: #e2e8f0;
  color: var(--navy-dark);
}

.segmented-pill-option input[type="radio"]:checked + .segmented-pill-btn {
  background-color: var(--primary-teal);
  color: #ffffff;
  border-color: var(--primary-teal);
  box-shadow: 0 4px 12px rgba(13, 148, 136, 0.25);
}

/* Modern Input Controls with Units and Icons */
.custom-input-group {
  position: relative;
  display: flex;
  align-items: center;
}

.input-leading-icon {
  position: absolute;
  left: 0.9rem;
  color: var(--slate-subtle);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
  z-index: 5;
}

.form-control-clinical {
  width: 100%;
  padding: 0.8rem 1rem 0.8rem 2.75rem;
  background-color: var(--bg-subtle);
  border: 2px solid transparent;
  border-radius: var(--radius-md);
  color: var(--navy-dark);
  font-size: 1rem;
  font-weight: 500;
  transition: all 0.2s ease;
}

.form-control-clinical:focus {
  background-color: #ffffff;
  border-color: var(--primary-teal);
  box-shadow: 0 0 0 4px var(--primary-teal-focus);
  outline: none;
}

.input-unit-badge {
  position: absolute;
  right: 1rem;
  background-color: #e2e8f0;
  color: var(--slate-text);
  font-size: 0.8rem;
  font-weight: 700;
  padding: 0.2rem 0.5rem;
  border-radius: var(--radius-sm);
  pointer-events: none;
}

/* Real-Time Live BMI Badge */
.live-bmi-box {
  background: linear-gradient(135deg, #f0fdfa, #e6fffa);
  border: 1px solid #99f6e4;
  border-radius: var(--radius-md);
  padding: 1rem 1.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 1rem;
}

.bmi-metric-val {
  font-size: 1.5rem;
  font-weight: 800;
  color: var(--primary-teal-dark);
}

/* --------------------------------------------------------------------------
   Badges, Risk Indicators & Attributions
   -------------------------------------------------------------------------- */
.risk-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.35rem 0.95rem;
  border-radius: var(--radius-pill);
  font-size: 0.88rem;
  font-weight: 700;
}

.risk-badge.Low {
  background-color: var(--risk-low-bg);
  color: var(--risk-low);
  border: 1px solid var(--risk-low-border);
}

.risk-badge.Moderate {
  background-color: var(--risk-moderate-bg);
  color: var(--risk-moderate);
  border: 1px solid var(--risk-moderate-border);
}

.risk-badge.High {
  background-color: var(--risk-high-bg);
  color: var(--risk-high);
  border: 1px solid var(--risk-high-border);
}

/* Stratification Progress Track */
.prob-track {
  background-color: #e2e8f0;
  border-radius: var(--radius-pill);
  height: 12px;
  overflow: hidden;
  position: relative;
}

.prob-fill {
  height: 100%;
  border-radius: var(--radius-pill);
  transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
}

.prob-fill.low { background-color: var(--risk-low); }
.prob-fill.moderate { background-color: var(--risk-moderate); }
.prob-fill.high { background-color: var(--risk-high); }

/* --------------------------------------------------------------------------
   Landing Page Styles
   -------------------------------------------------------------------------- */
.hero-section {
  padding: 5rem 1rem 4rem 1rem;
  background: radial-gradient(circle at 10% 20%, rgba(13, 148, 136, 0.08) 0%, rgba(248, 250, 252, 1) 90%);
}

.hero-pill-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.35rem 1rem;
  background-color: var(--primary-teal-light);
  color: var(--primary-teal-dark);
  border-radius: var(--radius-pill);
  font-size: 0.85rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
}

.hero-headline {
  font-size: 3.25rem;
  font-weight: 900;
  line-height: 1.15;
  color: var(--navy-dark);
  letter-spacing: -0.03em;
  margin-bottom: 1.5rem;
}

.hero-subhead {
  font-size: 1.2rem;
  color: var(--slate-text);
  max-width: 620px;
  margin-bottom: 2rem;
  line-height: 1.6;
}

.btn-primary-teal {
  background-color: var(--primary-teal);
  color: #ffffff;
  border: none;
  font-weight: 600;
  padding: 0.85rem 1.75rem;
  border-radius: var(--radius-md);
  box-shadow: 0 4px 14px rgba(13, 148, 136, 0.3);
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-primary-teal:hover {
  background-color: var(--primary-teal-dark);
  color: #ffffff;
  transform: translateY(-1px);
  box-shadow: 0 6px 18px rgba(13, 148, 136, 0.4);
}

.btn-outline-slate {
  background-color: transparent;
  color: var(--navy-dark);
  border: 1px solid var(--border-subtle);
  font-weight: 600;
  padding: 0.85rem 1.75rem;
  border-radius: var(--radius-md);
  transition: all 0.2s ease;
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-outline-slate:hover {
  background-color: var(--bg-surface);
  border-color: var(--slate-subtle);
  color: var(--navy-dark);
}

/* Feature Pillars Grid */
.feature-pillar-box {
  background-color: var(--bg-surface);
  border: 1px solid var(--border-card);
  border-radius: var(--radius-lg);
  padding: 2rem;
  height: 100%;
  box-shadow: var(--shadow-card);
  transition: all 0.2s ease;
}

.feature-pillar-box:hover {
  transform: translateY(-3px);
  box-shadow: var(--shadow-hover);
}

.pillar-icon-circle {
  width: 52px;
  height: 52px;
  border-radius: var(--radius-md);
  background-color: var(--primary-teal-light);
  color: var(--primary-teal);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.5rem;
  margin-bottom: 1.25rem;
}

/* Step Pipeline */
.workflow-pipeline-step {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 1.25rem;
}

.step-index-circle {
  width: 36px;
  height: 36px;
  border-radius: var(--radius-pill);
  background-color: var(--primary-teal);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.9rem;
  flex-shrink: 0;
}

/* --------------------------------------------------------------------------
   Loading Overlay & Feedback
   -------------------------------------------------------------------------- */
.loading-overlay {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: rgba(15, 23, 42, 0.65);
  backdrop-filter: blur(4px);
  z-index: 9999;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  color: #ffffff;
}

.loading-spinner {
  width: 50px;
  height: 50px;
  border: 4px solid rgba(255, 255, 255, 0.2);
  border-top-color: #2dd4bf;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 1rem;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* --------------------------------------------------------------------------
   Responsive Breakpoints
   -------------------------------------------------------------------------- */
@media (max-width: 992px) {
  .app-sidebar {
    transform: translateX(-100%);
  }
  .app-sidebar.show {
    transform: translateX(0);
  }
  .app-content-workspace {
    margin-left: 0;
  }
  .mobile-sidebar-toggle {
    display: block;
  }
  .hero-headline {
    font-size: 2.35rem;
  }
}

/* --------------------------------------------------------------------------
   Healthcare & Clinical Custom Utility Classes
   -------------------------------------------------------------------------- */
.text-teal {
  color: var(--primary-teal) !important;
}

.text-emerald {
  color: #059669 !important;
}

.bg-teal-subtle {
  background-color: var(--primary-teal-light) !important;
}

.bg-emerald-subtle {
  background-color: #d1fae5 !important;
}

.border-teal {
  border-color: var(--primary-teal) !important;
}

.border-emerald {
  border-color: #059669 !important;
}

.btn-outline-teal {
  color: var(--primary-teal);
  background-color: transparent;
  border-color: var(--primary-teal);
  font-weight: 600;
  border-radius: var(--radius-md);
  padding: 0.5rem 1.25rem;
  transition: all 0.2s ease;
}

.btn-outline-teal:hover {
  background-color: var(--primary-teal);
  color: #ffffff;
  border-color: var(--primary-teal);
}

