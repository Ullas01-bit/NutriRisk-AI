<script>
document.addEventListener("DOMContentLoaded", function() {
  const ageInput = document.getElementById("inputAge");
  if (!ageInput) return;

  const modalEl = document.getElementById("under18AlertModal");
  const under18Modal = new bootstrap.Modal(modalEl);

  function checkAgeBoundary() {
    const rawVal = ageInput.value.trim();
    if (!rawVal) return;
    const val = parseInt(rawVal, 10);
    if (!isNaN(val) && val > 0 && val < 18) {
      under18Modal.show();
    }
  }

  ageInput.addEventListener("change", checkAgeBoundary);
  ageInput.addEventListener("blur", checkAgeBoundary);

  document.getElementById("btnResetAge").addEventListener("click", function() {
    ageInput.value = "";
    ageInput.focus();
  });

  document.getElementById("btnSetAge18").addEventListener("click", function() {
    ageInput.value = "18";
  });

  // Check on load if form was re-rendered with underage value
  const initialAge = parseInt(ageInput.value, 10);
  if (!isNaN(initialAge) && initialAge > 0 && initialAge < 18) {
    checkAgeBoundary();
  }
});
</script>


